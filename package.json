    "react-day-picker": "^9.8.0",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.1.0",
    "recharts": "^2.15.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
