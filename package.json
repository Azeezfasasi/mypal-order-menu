{
  "name": "mypal-iconic-delicay-order-menu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run version:generate && npm run sw:update-version && npm run sw:update-env && next build",
    "build:server": "npm run version:generate && npm run sw:update-version && npm run sw:update-env && next build",
    "build:prod": "next build",
    "build:staging": "BUILD_ENV=staging NEXT_PUBLIC_STRIP_CONSOLE=false npm run build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next && rm -rf out && rm -rf node_modules/.cache",
    "dev:clean": "npm run clean && npm run dev",
    "version:generate": "node scripts/generate-version.cjs",
    "version:prod": "BUILD_ENV=production node scripts/generate-version.cjs",
    "version:check": "node scripts/check-version.js",
    "version:check:detailed": "node scripts/check-version.js --detailed",
    "sw:validate": "node src/scripts/validate-sw.js",
    "sw:update-version": "node scripts/update-sw-version.cjs",
    "sw:update-env": "node scripts/update-main-sw-env.cjs",
    "cache:clear": "node scripts/clear-cache.js",
    "cache:clear:build": "node scripts/clear-cache.js build",
    "cache:clear:packages": "node scripts/clear-cache.js packages",
    "cache:clear:browser": "node scripts/clear-cache.js browser",
    "setup:scripts": "mkdir -p scripts",
    "preinstall": "npm run setup:scripts",
    "deploy:staging": "npm run build:staging && npm run sw:validate && npm run start",
    "deploy:production": "BUILD_ENV=production npm run build:prod && npm run sw:validate && npm run start",
    "health:check": "npm run version:check && npm run sw:validate",
    "clean:all": "npm run cache:clear && npm run build"
  },
